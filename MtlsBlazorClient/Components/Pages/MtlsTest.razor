@page "/MTLSTest"
@attribute [StreamRendering]


@* @inject HttpClient http   *@
@inject IHttpClientFactory httpClientFactory

<h3>Mutual Transport Layer Security (mTLS) Test</h3>

<button @onclick="CallApi">Call Secured API</button>

@if (_response != null)
{
    <pre>@_response</pre> 
}

@code {
    private string? _response;

    private async Task CallApi()
    {
        // var result = await http.GetAsync("api/secure/ping");
        // _response = await result.Content.ReadAsStringAsync();

        var client = httpClientFactory.CreateClient("MtlsClient");
        var result = await client.GetAsync("api/secure/ping");
        var rawJson = await result.Content.ReadAsStringAsync();

        try
        {
            var jsonElement = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(rawJson);
            _response = System.Text.Json.JsonSerializer.Serialize(jsonElement, 
                                 new System.Text.Json.JsonSerializerOptions { WriteIndented = true }
                            );
        }
        catch 
        {
            // Fallback to raw string if it's not valid JSON
            _response = rawJson;
        }
    }
}
